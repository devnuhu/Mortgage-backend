{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "SET-IN-USER-SECRETS-OR-ENVIRONMENT",
    "SmsNotificationConnection": "SET-IN-USER-SECRETS-OR-ENVIRONMENT"
  },
  "JwtSettings": {
    "SecretKey": "SET-IN-USER-SECRETS-OR-ENVIRONMENT",
    "Issuer": "MMGT.API",
    "Audience": "MMGT.Client",
    "ExpirationInMinutes": 60
  },
  "FileStorage": {
    "StorageType": "Database",
    "MaxFileSizeInMB": 0.3,
    "AllowedExtensions": [ ".pdf" ]
  },
  "LegacyStoragePaths": {
    "OldServerRoot": "C:\\inetpub\\wwwroot\\backend\\AccessMortgage\\wwwroot",
    "NewServerRoot": "C:\\inetpub\\wwwroot\\Mortgage\\wwwroot"
  }
}